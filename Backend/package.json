    "author": "FINASSIST Team",
    "license": "MIT",
    "dependencies": {
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^7.5.0",
        "morgan": "^1.10.0",
        "nodemailer": "^10.1.7",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.1.0",
        "supertest": "^7.3.1"
    },
    "engines": {
        "node": ">=22.0.0"
    }
