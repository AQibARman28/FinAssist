{
    "name": "finassist-backend",
    "version": "1.0.0",
    "description": "FINASSIST - Financial Management Backend API",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "test": "jest",
        "security:audit": "npm audit --omit=dev --audit-level=high",
        "check:legacy-crypto": "node legacy_crypto/check-no-imports.js",
        "migrate:wrap-legacy-passwords": "node scripts/wrap-legacy-password-hashes.js",
        "migrate:field-encryption": "node scripts/upgrade-field-encryption.js",
        "migrate:reattest": "node scripts/reattest-records.js",
        "migrate:audit-retention": "node scripts/migrate-audit-retention.js",
        "rotate:master-key": "node scripts/rotate-master-key.js",
        "migrate:email-hash": "node scripts/migrate-email-hash.js",
        "migrate:existing-users": "node scripts/migrate-existing-users.js",
        "migrate:expense-categories": "node scripts/migrate-expense-categories.js",
        "migrate:budget-categories": "node scripts/migrate-budget-categories.js"
    },
    "keywords": [
        "fintech",
        "expense-tracker",
        "budget-management",
        "financial-goals",
        "nodejs",
        "express",
        "mongodb"
