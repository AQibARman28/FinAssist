NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finassist?retryWrites=true&w=majority

# JWT signing secret (HS256). 64 hex chars from crypto.randomBytes(32).
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
# Access-token TTL. Tokens live in the fa_access cookie. The refresh cookie
# (fa_refresh) is a server-side RefreshToken row, hard-coded at 7 days.
ACCESS_TOKEN_TTL=15m

FRONTEND_URL=http://localhost:3000

# AES-256-GCM master key for wrapping per-user data keys. 64 hex chars.
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars_from_crypto_randomBytes_32

# Keyed-HMAC secret for hashing emails for unique lookup. 64 hex chars.
EMAIL_HASH_SECRET=replace_with_64_hex_chars_from_crypto_randomBytes_32

# ── Email verification (SEC-1 Phase 4) ──────────────────────────────────────
# Outbound SMTP for verification emails. If SMTP_HOST is unset, the dev mailer
# logs each message to the console instead of sending it, so registration
# still works without an SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinAssist <no-reply@finassist.local>

# JWT_EXPIRE and HMAC_SECRET were retired in SEC-1 Phases 2/3 (record-integrity
# HMACs dropped; JWT TTL split into access/refresh). They can be removed from
# existing environments; the server no longer reads them.
