NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finassist?retryWrites=true&w=majority

# JWT signing secret (HS256). 64 hex chars from crypto.randomBytes(32).
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRE=30d

FRONTEND_URL=http://localhost:3000

# AES-256-GCM master key for wrapping per-user data keys. 64 hex chars.
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars_from_crypto_randomBytes_32

# Keyed-HMAC secret for hashing emails for unique lookup. 64 hex chars.
# Without this, an attacker who reads the User collection could brute-force
# the membership of any candidate email by computing sha256 lookups.
EMAIL_HASH_SECRET=replace_with_64_hex_chars_from_crypto_randomBytes_32

# HMAC_SECRET was retired in SEC-1 Phase 2 (record-integrity HMACs dropped —
# AES-GCM auth tags + ECDSA serverAttestation already cover integrity). The
# variable can be removed from existing environments; the server no longer
# reads it.
