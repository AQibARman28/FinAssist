NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finassist?retryWrites=true&w=majority

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start if any is missing or malformed (utils/config.js).

# JWT signing secret (HS256), at least 32 bytes. During a rotation, put the old
# value in JWT_SECRET_PREVIOUS so sessions signed with it keep working until
# they expire.
JWT_SECRET=replace_with_64_hex_chars
JWT_SECRET_PREVIOUS=
# Access-token TTL. Tokens live in the fa_access cookie. Refresh tokens
# (fa_refresh) are server-side rows: 7 days, or 30 with "remember me".
ACCESS_TOKEN_TTL=15m

FRONTEND_URL=http://localhost:3000

# AES-256-GCM master key wrapping per-user data keys — exactly 64 hex chars.
# BACK THIS UP. To rotate: move the current value to MASTER_ENCRYPTION_KEY_PREVIOUS,
# set a new one, then run `npm run rotate:master-key -- --apply`.
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars
MASTER_ENCRYPTION_KEY_PREVIOUS=

# Keyed-HMAC secret for the email lookup index — exactly 64 hex chars.
EMAIL_HASH_SECRET=replace_with_64_hex_chars

# Shared secret the frontend proxy sends as X-FinAssist-Proxy. When set, the
# API refuses requests without it (closes direct calls to the backend URL).
# Set the same value on the frontend. Leave empty for local development.
PROXY_SHARED_SECRET=

# Reverse-proxy hops in front of the API: 2 for Vercel -> Render, 1 for
# docker-compose, 0 for none.
TRUST_PROXY=2

# ── Email ────────────────────────────────────────────────────────────────────
# Verification is ON in production by default and OFF in development.
# Production refuses to start without a mail provider unless this is false.
REQUIRE_EMAIL_VERIFICATION=
# Resend's HTTPS API (works where SMTP ports are blocked, e.g. Render free).
RESEND_API_KEY=
# Or SMTP. With neither set, development prints mail to the console and
# production logs only a redacted subject line.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinAssist <no-reply@finassist.local>

# Breached-password screening via the Have I Been Pwned range API
# (k-anonymity). On by default in production; "hibp" forces it on, "off" disables.
PASSWORD_BREACH_CHECK=

# Optional rate-limit overrides (requests per 15 minutes per IP).
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_REFRESH_MAX=120
