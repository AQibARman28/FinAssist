# Server-side only (no NEXT_PUBLIC_ prefix): read by src/proxy.ts and
# next.config.ts, never shipped to the browser.

# Where /api/* is forwarded. Local dev: the Express API on :5000.
BACKEND_ORIGIN=http://localhost:5000

# Must match the backend's PROXY_SHARED_SECRET. Leave empty locally.
PROXY_SHARED_SECRET=

# Self-hosted only: the single-address header your reverse proxy sets with the
# visitor's IP (e.g. x-real-ip). Not needed on Vercel, whose x-real-ip is used.
# Unset, no client-supplied address reaches the API.
CLIENT_IP_HEADER=
