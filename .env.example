# Root .env — used by docker-compose (the VPS / self-host path).
# For the free Vercel + Render path, set these in those dashboards instead
# (see DEPLOY.md). Generate each 64-hex secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MongoDB connection (Atlas recommended). URL-encode any % in the password as %25.
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finassist?retryWrites=true&w=majority

# JWT access-token signing secret (HS256) — 64 hex chars.
JWT_SECRET=replace_with_64_hex_chars
# Access-token TTL (refresh token is a server-side row, fixed at 7 days).
ACCESS_TOKEN_TTL=15m

# AES-256-GCM master key wrapping per-user data keys — 64 hex chars.
# ⚠ BACK THIS UP. Losing it makes all encrypted PII (emails, names, goal
#   titles, notes) permanently unrecoverable. Never change it on a live DB.
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars
# Keyed-HMAC secret for unique email lookup — 64 hex chars.
EMAIL_HASH_SECRET=replace_with_64_hex_chars

# Public URL of the frontend (used for CORS + verification email links).
FRONTEND_URL=http://localhost:3000

# Optional outbound SMTP for verification emails. If SMTP_HOST is empty the
# backend logs each email to the console instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinAssist <no-reply@finassist.local>
