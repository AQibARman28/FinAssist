# Root .env — used by docker-compose (the VPS / self-host path).
# For the free Vercel + Render path, set these in those dashboards instead
# (see DEPLOY.md). Generate each 64-hex secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MongoDB inside the compose network (never published to the host).
# The root account administers the database; the API connects as the
# least-privilege app user created by docker/mongo-init.js.
MONGO_ROOT_USER=finassist_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_APP_USER=finassist_app
MONGO_APP_PASSWORD=replace_with_a_different_long_random_password

# JWT access-token signing secret (HS256): at least 32 bytes (64 hex chars is
# simplest). During a rotation, the old value goes in JWT_SECRET_PREVIOUS.
JWT_SECRET=replace_with_64_hex_chars
JWT_SECRET_PREVIOUS=
# Access-token TTL (refresh tokens are server-side rows: 7 days, 30 with "remember me").
ACCESS_TOKEN_TTL=15m

# AES-256-GCM master key wrapping per-user data keys — exactly 64 hex chars.
# BACK THIS UP. Losing it makes all encrypted PII permanently unrecoverable.
# To rotate it: move the current value to MASTER_ENCRYPTION_KEY_PREVIOUS, set a
# new one, then run Backend/scripts/rotate-master-key.js (docs/security/key-management.md).
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars
MASTER_ENCRYPTION_KEY_PREVIOUS=
# Keyed-HMAC secret for the email lookup index — exactly 64 hex chars.
EMAIL_HASH_SECRET=replace_with_64_hex_chars

# Shared secret the Next proxy adds to every API call; the API refuses
# requests without it. Any long random string (64 hex chars recommended).
PROXY_SHARED_SECRET=replace_with_64_hex_chars

# Public URL of the frontend (used for CORS and links in emails).
FRONTEND_URL=http://localhost:3000

# Email. Verification is ON in production: the API refuses to start without a
# mail provider unless REQUIRE_EMAIL_VERIFICATION=false. Resend (HTTPS) works
# where SMTP ports are blocked; it takes priority over SMTP when set.
REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinAssist <no-reply@finassist.local>

# Breached-password screening (Have I Been Pwned range API, k-anonymity).
# On by default in production; "off" disables it.
PASSWORD_BREACH_CHECK=
# Audit-log retention in days.
AUDIT_RETENTION_DAYS=180

# Behind your own reverse proxy: the single-address header it sets with the
# visitor's IP (e.g. x-real-ip), so the API can rate-limit per visitor.
CLIENT_IP_HEADER=
